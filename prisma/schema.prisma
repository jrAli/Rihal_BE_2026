// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// @See http://prisma.io/docs/prisma-orm/quickstart/postgresql

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Entity used for soft deletion configuration
model config {
  id            String @id @default(uuid())
  key           String @unique
  value         String
}
model Appointment {
  id            String        @id @default(uuid())
  customerID    String   
  customer      Customer      @relation(fields: [customerID], references: [id])
  staffID       String?
  staff         Staff?        @relation(fields: [staffID], references: [id])
  slotID        String        @unique
  slot          Slot          @relation(fields: [slotID], references: [id])
  
  // (e.g., checked-in, no-show, completed)
  status        String
  notes         String?
  createdAt     DateTime     
  updateAt      DateTime
  branchID      String
  branch        Branch        @relation(fields: [branchID], references: [id])
}

model ServiceType {
  id            String        @id @default(uuid())
  name          String    
  branchID      String
  branch        Branch        @relation(fields: [branchID], references: [id])
  createdAt     DateTime

  // back-reference
  slots         Slot[]
}

model Slot {
  id            String        @id @default(uuid())
  branchID      String
  branch        Branch        @relation(fields: [branchID], references: [id])
  serviceIDType String
  serviceType   ServiceType   @relation(fields: [serviceIDType], references: [id])
  staffID       String?
  staff         Staff?        @relation(fields: [staffID], references: [id])
  startTime     DateTime      
  endTime       DateTime
  isAvailable   Boolean 
  deleteAt      DateTime?
  createdAt     DateTime

  // back-reference
  appointment   Appointment?  // optional, one-to-one relationship
}

model Customer {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String        
  idImagePath   String
  createdAt     DateTime

  // back-reference
  appointments  Appointment[]
}

model Staff {
  id            String        @id @default(uuid())
  name          String        
  email         String        @unique
  password      String        
  role          String        //..
  branchID      String?       // Optional since admin doesn't have branch id
  branch        Branch?       @relation(fields: [branchID], references: [id])

  // back-reference
  slots         Slot[]
  appointments  Appointment[]
  auditLogs     AuditLog[]
}

model Branch {
  id            String        @id @default(uuid())
  name          String
  createdAt     DateTime
  location      String

  // back-references
  serviceType   ServiceType[]
  slots         Slot[]
  staff         Staff[]
  appointments  Appointment[]
  auditLogs     AuditLog[]
}

model AuditLog {
  id            String        @id @default(uuid())
  actorID       String
  actor         Staff         @relation(fields: [actorID], references: [id])
  actorRole     String        
  action        String
  targetType    String
  targetID      String        
  branchID      String
  branch        Branch        @relation(fields: [branchID], references: [id])
  metadata      String?
  createdAt     DateTime
}



